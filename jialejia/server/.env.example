# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jialejia

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# SMS (阿里云/腾讯云)
SMS_ACCESS_KEY=your_sms_key
SMS_SECRET_KEY=your_sms_secret
SMS_SIGN_NAME=佳乐家

# OSS (阿里云OSS / 腾讯云COS)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=jialejia
OSS_ACCESS_KEY=your_oss_key
OSS_SECRET_KEY=your_oss_secret